  <script isEscaped="1" name="ScopeLib"><![CDATA[#uses &quot;classes/GUI/GUINaviButtonCollection&quot;
#uses &quot;PT_SIEM_FRAMEWORK.ctl&quot;

//shared_ptr&lt;GUINaviButtonCollection&gt; ButtonCollection = new GUINaviButtonCollection();
int iMyScreenNumber = GetMyScreenNumber(); //Ahmed get out the screen number

dyn_int diSeparateNavigationItems = makeDynInt(); //this list must come from some usersettings (e.g. plant model)

public shared_ptr&lt;GUINaviButtonCollection&gt; GetGuiNaviButtonCollection()
{
  return daCollection[iMyScreenNumber];
}

string actualPanelName;
string strServerName = getSystemName();
int iFreePos = -1;
dyn_int diLastQuickNaviButtons;

synchronized initButtons(dyn_int diNodes = makeDynInt())
{
  bool bQuickNaviButtons;

  if (dynlen(diNodes) &gt; 0)
  {
    if (dynlen(diNodes) == 1 &amp;&amp; diNodes[1]==-1) //-1 means no quick buttons for this user
      diNodes = makeDynInt();

    bQuickNaviButtons = TRUE;
    //remove existing quick navibuttons of last user
    if (dynlen(diLastQuickNaviButtons) &gt; 0)
      PT_SIEM_removeNaviButton(diLastQuickNaviButtons, &quot;naviModuleA_&quot; + iMyScreenNumber, TRUE);
    diLastQuickNaviButtons = diNodes;
  }


  int error = pt_checkPanelTopologyCache();

  dyn_int diIDToIgnore;

  for (int i = dynlen(g_PanelTopologyCache[strServerName + &quot;_PanelTopology.nodeName&quot;]); i &gt; 0; i--) //1 because ignore start/root node
  {



    if (g_PanelTopologyCache[strServerName + &quot;_PanelTopology.nodeName&quot;][i] == &quot;. . .&quot; )
    {
      iFreePos = i;
      continue;
    }
    else if (iFreePos == -1)
    {
      continue;
    }

    if (bQuickNaviButtons &amp;&amp; dynContains(diNodes, i) &lt; 1) //ignore if not in list
    {
      continue;
    }


    int iPos = i; //pt pos

    if (g_PanelTopologyCache[strServerName + &quot;_PanelTopology.fileName&quot;][i] == &quot;main.pnl&quot; &amp;&amp; i != 1)
    {
      iPos *= -1;
    }

    // add buttons for navigation and reigster them
    shape shButtonRef = PT_SIEM_addNaviButton(i, g_PanelTopologyCache[strServerName + &quot;_PanelTopology.parentNumber&quot;][i]/*, daCollection[iMyScreenNumber]*/, EMBEDDED_MODULE3.ModuleName,
                        (bQuickNaviButtons || g_PanelTopologyCache[strServerName + &quot;_PanelTopology.parentNumber&quot;][i] &lt;= 1) &amp;&amp; getUserPermission(g_PanelTopologyCache[strServerName + &quot;_PanelTopology.permissionBit&quot;][i]),
                        FALSE, bQuickNaviButtons); //only top nodes are visible
  }


}

setButtonVisibility(string s, string sUser)
{
  if (dynlen(daCollection) &gt;= iMyScreenNumber)
  {
    for (int i = 0; i &lt; daCollection[iMyScreenNumber].Count()  ; i++)
    {

      shared_ptr&lt;GUINaviButton&gt; obj = daCollection[iMyScreenNumber].GetByIndex(i);

      if (getTypeName(obj) == &quot;GUINaviPanelButton&quot;  || getTypeName(obj) == &quot;GUIQuickNaviPanelButton&quot;)
      {
        int iPtNodeId = obj.getChildPanelNumber(); //ddsNavibuttonsPerScreen[iMyScreenNumber][i+1];
        bool bVisible = getUserPermission(g_PanelTopologyCache[strServerName + &quot;_PanelTopology.permissionBit&quot;][iPtNodeId]) &amp;&amp;
                        ((getTypeName(obj)) == &quot;GUIQuickNaviPanelButton&quot; ? TRUE :
                         (int)g_PanelTopologyCache[strServerName + &quot;_PanelTopology.parentNumber&quot;][iPtNodeId] &lt;= 1) ; //hide subnodes on user switch
        PT_SIEM_setVisibleNaviButton(i, EMBEDDED_MODULE3.ModuleName(), bVisible);

      }
    }
  }

  string sFormat;
  dyn_string dsContent;
  langString lsName;
  string sGroup;
  //read user quick navi
  uss_getSpecificUserSetting(sUser, &quot;userQuickNavigation&quot;, sFormat, dsContent, lsName);
  string sEntries;

  if (dynlen(dsContent) &gt; 0)
    sEntries = dsContent[1];

  dynClear(dsContent);
  //add also global quick navi
  //uss_getSpecificSetting(&quot;_usr&quot;, sGroup, &quot;globalQuickNavigation&quot;, sFormat, dsContent, lsName);
   uss_getSpecificSettingGlobally( sGroup, &quot;globalQuickNavigation&quot;, sFormat, dsContent, lsName);

  if (dynlen(dsContent) &gt; 0)
    sEntries += &quot;|&quot; + dsContent[1];

  strreplace(sEntries, &quot;,&quot;, &quot;|&quot;);
  dsContent = strsplit(sEntries, &quot;|&quot;);

  if (dynlen(dsContent) == 0)
    dsContent = makeDynInt(-1);

  initButtons(dsContent);

}


public PT_SIEM_setVisibleNaviButton(int iButtonIndex, string moduleName = myModuleName(), bool bVisible) synchronized(ddsNavibuttonsPerScreen)
{
  string panelName = rootPanel(moduleName);
  int iScreennumber = GetMyScreenNumber();//Ahmed change the screen number

  {
    daCollection[iScreennumber].GetByIndex(iButtonIndex).SetRefVisible(bVisible);
  }
}

int uss_getSpecificSettingGlobally(string sGroupOrUser,string sSettingName,string &amp;sFormat, dyn_string &amp;dsContent,langString &amp;lsName)
{
    int iErr = uss_getSpecificSetting(&quot;_usr&quot;, sGroupOrUser, sSettingName, sFormat, dsContent, lsName);
    if(iErr == -1) return iErr;
    if( lsName == &quot;&quot;)
    {
      iErr != 0? iErr = 0 : NULL;
      iErr == uss_getSpecificSetting(&quot;_usg&quot;, sGroupOrUser, sSettingName, sFormat, dsContent, lsName);
      if(iErr == -1) return iErr;
    }
    if( lsName == &quot;&quot;)
    {
      iErr != 0? iErr = 0 : NULL;
      iErr == uss_getSpecificSetting(&quot;_uss&quot;, sGroupOrUser, sSettingName, sFormat, dsContent, lsName);
      if(iErr == -1) return iErr;

    }



}

]]></script>
  <script isEscaped="1" name="Initialize"><![CDATA[#uses &quot;uss_userSettings&quot;
#uses &quot;PT_SIEM_FRAMEWORK&quot;

main()
{

  g_textBeforeIcon              = searchConfigInAllLevels(&quot;config.level&quot;, &quot;pt_siem_framework&quot;, &quot;textBeforeIcon&quot;            , &quot;     &quot;);
  g_bShowTextBeforeIconOnlyOnce = searchConfigInAllLevels(&quot;config.level&quot;, &quot;pt_siem_framework&quot;, &quot;showTextBeforeIconOnlyOnce&quot;, FALSE  );
  g_hideSubMenuOnCollapse       = searchConfigInAllLevels(&quot;config.level&quot;, &quot;pt_siem_framework&quot;, &quot;hideSubMenuOnCollapse&quot;     , FALSE  );



  firstTime = true;
  bool Pressed = false;
  EMBEDDED_MODULE3.ModuleName =  ptms_BuildModuleName(&quot;naviModuleA&quot;, iMyScreenNumber);
  RootPanelOnModule(&quot;para/PanelTopology/templates/SIE/menu_button_module&quot;, &quot;menu_buttons&quot;, EMBEDDED_MODULE3.ModuleName, makeDynString());
  Init_btns(daCollection);

  initButtons();
  dpConnect(&quot;setButtonVisibility&quot;, TRUE, myUiDpName() + &quot;.UserName&quot;);

  while (true)
  {
    int width, hight;
    getValue(this, &quot;size&quot;, width, hight);


    if (width &lt;= 280 &amp;&amp; Pressed)
    {
      EMBEDDED_MODULE3.contentsX(0);

      collapseMenu(1);
      Pressed = false;

      EMBEDDED_MODULE3.hScrollBarMode(&quot;AlwaysOff&quot;);

    }

    else if (width &gt; 280 &amp;&amp; ! Pressed)
    {

      collapseMenu(0);
      firstTime = false;
      Pressed = true;
      EMBEDDED_MODULE3.horizontalScrollBarPolicy(&quot;ScrollBarAsNeeded&quot;);
      EMBEDDED_MODULE3.hScrollBarMode(&quot;Auto&quot;);

    }

    delay(0.3);
  }
}


]]></script>
