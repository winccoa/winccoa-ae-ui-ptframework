   <events>
    <script isEscaped="1" name="Initialize"><![CDATA[#uses &quot;classes/GUI/GUIFaceplate&quot;

dyn_string dsFaceplates;

main()
{
  GUIFaceplate::AddFunctionPtr(
    self.faceplateToOpen,
    self.detailToOpen,
    g_iNumber
  );

  RootPanelOnModule(
    &quot;/IX/faceplates/faceplateSideModuleBasePanel&quot;,
    &quot;menu&quot;,
    faceplateModule.ModuleName(),
    makeDynString(
      &quot;$moduleName:&quot; + myModuleName(),
      &quot;$modName:&quot; + faceplateModule.ModuleName(),
      &quot;$beamed:&quot; + false
    )
  );

  uiConnect(
    &quot;visibleCB&quot;,
    self.faceplateToOpen
  );
}


visibleCB(string sFaceplate, bool bOpen)
{
  if (
    sFaceplate != &quot;&quot; &amp;&amp;
    strpos(sFaceplate, &quot;§&quot;) &gt; 0
  )
  {
    sFaceplate = substr(
      sFaceplate,
      0,
      strpos(sFaceplate, &quot;§&quot;)
    );
  }

  int iPos = dynContains(
    dsFaceplates,
    sFaceplate
  );

  if (
    sFaceplate == &quot;&quot; &amp;&amp;
    !bOpen
  )
  {
    // Clear all faceplates
    dynClear(dsFaceplates);
    this.visible(false);
  }
  else if (bOpen)
  {
    if (iPos &lt; 1)
    {
      dynAppend(
        dsFaceplates,
        sFaceplate
      );

      this.visible(true);
    }
  }
  else
  {
    // Close faceplate
    if (iPos &gt; 0)
    {
      dynRemove(
        dsFaceplates,
        iPos
      );

      this.visible(
        dynlen(dsFaceplates) &gt; 0
      );
    }
  }
}]]></script>
   </events>
  </shape>
  <shape Name="detailModule" layerId="0" shapeType="EMBEDDED_MODULE">
