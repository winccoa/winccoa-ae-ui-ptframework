    <script isEscaped="1" name="Initialize"><![CDATA[main()
{
  if (!IsPanelTopologyInstance())
  {
    return;
  }

  string moduleDp =
    basePanel.GetInfoPanelName();

  if (!dpExists(moduleDp))
  {
    dpCreate(
      moduleDp,
      &quot;ExampleDP_Bit&quot;
    );

    delay(1);
  }

  dpSet(
    moduleDp + &quot;.&quot;,
    TRUE
  );

  dpConnect(
    &quot;work&quot;,
    moduleDp + &quot;.&quot;
  );
}


work(
  string dp,
  bool vis
)
{
  this.visible = vis;
}]]></script>
