   </properties>
   <events>
    <script isEscaped="1" name="Initialize"><![CDATA[#uses &quot;classes/GUI/GUIFaceplate&quot;

main()
{
//   pt_checkPanelTopologyCache();

  //RootPanelOnModule(&quot;/IX/faceplates/detail&quot;, &quot;menu&quot;, faceplateModule.ModuleName(), makeDynString(&quot;$moduleName:&quot; + myModuleName(), &quot;$modName:&quot; + faceplateModule.ModuleName(), &quot;$beamed:&quot; + false));

  uiConnect(&quot;visibleCB&quot;, self.detailToOpen);
}

visibleCB(string sDetailPanel, dyn_string dsDollar, bool bOpen)
{
  string sPanelId = sDetailPanel + &quot;§&quot; + (string)dsDollar;

  int iPos = dynContains(dsPanels, sPanelId);

  if(bOpen)
  {
    if (iPos &gt; 0) //move to end
      dynRemove(dsPanels, iPos);

    dynAppend(dsPanels, sPanelId);
  }
  else
  {
    if (iPos &gt; 0)
      dynRemove(dsPanels, iPos);
  }
  if (dynlen(dsPanels) &gt; 0)
  {
    dyn_string ds = strsplit(dsPanels.last(), &quot;§&quot;);
    string sPanel = ds[1];
    dyn_string dsDollars;
    if (dynlen(ds) &gt; 1 &amp;&amp; strlen(ds[2])&gt;0)
    {
      dsDollars = strsplit(ds[2], &quot; | &quot;);
    }
    dyn_int diSize = getPanelSize(sPanel);

    setMultiValue(&quot;detailModule&quot;, &quot;minimumSize&quot;, diSize[1], diSize[2],
                  &quot;detailModule&quot;,&quot;maximumSize&quot;, diSize[1], diSize[2]);
    RootPanelOnModule(sPanel, dsPanels.last() , this.ModuleName(), dsDollars);
    this.visible(true);
  }
  else
    this.visible(false);
}
]]></script>
