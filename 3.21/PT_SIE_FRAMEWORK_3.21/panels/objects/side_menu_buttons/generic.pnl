"$bVisible"
"$nodeId"
"main()
{
  this.visible = $bVisible;

  userButton.SetPointer(userButton);

  string strServerName = getSystemName();

  pt_checkPanelTopologyCache();
  int iPos = $nodeId;

  if (iPos < 1)
    iPos *= -1;
  else
    userButton.SetText(g_PanelTopologyCache[strServerName + \"_PanelTopology.nodeName\"][iPos]);

  string sIcon = g_PanelTopologyCache[strServerName + \"_PanelTopology.iconName\"][iPos];


  if ($nodeId == 1 && sIcon == \"\")
    sIcon = \"Siemens_Dark/white/home_icon1.svg\";

  if (((int)$nodeId) > 0)
    userButton.SetIcon(sIcon);

  if ($nodeId > 0)
  {

    string       dpe;
    dyn_int      panelNumber;
    dyn_string   prioRanges, fileNames;

    dpGet(\"_SumAlertGeneral.prioRange.name\", prioRanges);

    panelNumber  = g_PanelTopologyCache[ getSystemName()  + \"_PanelTopology.sumAlertNumber\"];
    fileNames  = g_PanelTopologyCache[ getSystemName()  + \"_PanelTopology.fileName\"];

    dpe = pt_fileNameToDpName(fileNames[iPos], panelNumber[iPos]);
    if (dpe == \"_1\" || !dpExists(dpe))
      return;

    dyn_string dsElements;

    for (int i = 1 ; i <= dynlen(prioRanges) ; i++)
    {
      dynAppend(dsElements, dpe + \".\" + prioRanges[i] + \":_alert_hdl.._act_state_color\");
    }

    if (dynlen(dsElements) > 0)
    {
      dpConnect(\"EP_setBackColorCB\", dsElements);
    }
  }
}


EP_setBackColorCB(dyn_string dpSource, dyn_string dsNewColor)
{
  //
  string sNewColor;

  for (int i = dynlen(dsNewColor); i > 0 && sNewColor == \"\" ; i--)
  {
    if (dsNewColor[i] != \"\")
    {
      sNewColor = dsNewColor[i];

    }
  }

  setValue(\"iconRef.rIcon\", \"foreCol\", sNewColor == \"\" ? \"_Transparent\" : sNewColor);
}






