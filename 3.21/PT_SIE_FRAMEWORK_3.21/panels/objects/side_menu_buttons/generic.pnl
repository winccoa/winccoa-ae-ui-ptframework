main()
{
  if ($bQuickNaviButton == TRUE) //no subnode on quick buttons
    return;

  int myID = (int)$nodeId;

  if ((bool)$bParentNode == TRUE)
  {
    if (doIhaveAChild(myID))
    {
      this.text = \"+ \";
      this.visible = true;
    }
  }
  else if (GetParentID(myID) == 0)
  {
    this.text = \"\";
    this.visible = false;
  }
  else
  {
    if (doIhaveAChild(myID))
    {
      this.text = \"+ \";
      this.visible = true;
    }
    else
    {
      this.text = \"\";
      this.visible = false;
    }
  }

}


int GetParentID(int myID)
{


  string strServerName = getSystemName();
  dyn_string ParentNumbers;
  dpGet(strServerName + \"_PanelTopology.parentNumber\", ParentNumbers);

  int val;

//DebugTN(\"myID\",myID,\"(int)ParentNumbers[myID]\",(int)ParentNumbers[myID]);
  if (myID == 1)
    val = 0;
  else if (myID == -1)
  {
// DebugTN(\"my ID is -1\");
    val = -1;
  }
  else
    val = (int)ParentNumbers[myID];

  return val;

}

