shared_ptr<GUINaviButton> userButton = ((int)$nodeId) < 0 ? (new GUINaviUserButton(getShape(\"textRef\"), getShape(\"iconRef\"), getShape(\"frameSelector\"))) : //login & logout button
                                       ($bQuickNaviButton == TRUE ? new GUIQuickNaviPanelButton(getShape(\"textRef\"), getShape(\"iconRef\"), getShape(\"frameSelector\"), $nodeId) :
                                        (new GUINaviPanelButton(getShape(\"textRef\"), getShape(\"iconRef\"), getShape(\"frameSelector\"), $nodeId))); //normal pt navigation button


public shared_ptr<GUINaviButton> GetGUINaviButton()
{
  return userButton;
}



//'Ahmed added this part
int iMyScreenNumber = GetMyScreenNumber(); //get out the screen number

dyn_int GetMyChildrenAndGrands(int currentParentIndex)
{
  string strServerName = getSystemName();
  dyn_uint ParentNumbers;
  dyn_int childIndices;

  dpGet(strServerName + \"_PanelTopology.parentNumber\", ParentNumbers);

  for (int i = 1; i <= dynlen(ParentNumbers); i++)
  {

    if (ParentNumbers[i] == currentParentIndex)
    {
      childIndices.append(i);

      //recursive loop
      dyn_int grandChildren = GetMyChildrenAndGrands(i);

      for (int j = 1; j <= dynlen(grandChildren); j++)
      {
        childIndices.append(grandChildren[j]);
      }
    }
  }


  return childIndices;
}


dyn_int GetMyChildren(int currentParentIndex, bool bRecursive = FALSE)
{

  string strServerName = getSystemName();
  dyn_uint ParentNumbers;
  dyn_int childIndecies;
  dpGet(strServerName + \"_PanelTopology.parentNumber\", ParentNumbers);

  for (int i = 1; i <= dynlen(ParentNumbers); i++)
  {

    if (ParentNumbers[i] == currentParentIndex)
    {
      childIndecies.append(i);
      if (bRecursive)
        dynAppend(childIndecies, GetMyChildren(i, bRecursive));
    }
  }

  return childIndecies;

}

 void showSubNodes(bool bVisible)
{

  string strServerName = getSystemName();
  string moduleName = myModuleName(); //\"naviModule_1\"; /*\"_QuickTest_\";*/
  string panelName = rootPanel(moduleName);//\"Navi\";/*\"para/PanelTopology/templates/SIE/naviPanel_1024_768_SIE.pnl\";*/
  int parentID = (int)$nodeId;
  dyn_int myChildrensIndecies = GetMyChildren(parentID, !bVisible);

  shape shPanel = getShape(moduleName + \".\" + rootPanel(moduleName) +\":\");
  shPanel = shPanel.parentShape();
  shPanel = shPanel.panel();

  for (int i = dynlen(myChildrensIndecies); i >= 1 ; i--) //1 because ignore start/root node
  {
    int iIndex = -1;

    for (int j = daCollection[iMyScreenNumber].Count()-1; j >= 0 && iIndex < 0; j--)
    {
      if (getTypeName(daCollection[iMyScreenNumber].GetByIndex(j)) == \"GUINaviPanelButton\"  &&
          daCollection[iMyScreenNumber].GetByIndex(j).getChildPanelNumber() == myChildrensIndecies[i])
      {
        iIndex = j;
      }
    }

    //parameter needs to be index in collection (starting at 0)
    invokeMethod(shPanel, \"PT_SIEM_setVisibleNaviButton\", iIndex, myModuleName(), bVisible);
  }
}


